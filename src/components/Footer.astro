---
import { site } from '../data/site';
---

<footer class="border-t border-slate-200 py-10 dark:border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-center sm:flex-row sm:px-6 sm:text-left">
    <div class="flex items-center gap-3">
      <div>
        <p class="font-display font-bold text-slate-900 dark:text-white">{site.nombre}<span class="text-lime-500 dark:text-lime-300">.</span></p>
        <p class="text-sm text-slate-500">{site.rol} · {site.ubicacion}</p>
      </div>
    </div>
    <p class="text-xs text-slate-500">
      Respaldo: <strong class="text-slate-700 dark:text-slate-300">{site.empresa}</strong> · Astro + Tailwind · Vercel
    </p>
  </div>
</footer>

<a
  href={site.whatsappLink}
  target="_blank"
  rel="noopener"
  aria-label="Hablar por WhatsApp"
  class="group fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full border border-lime-200/30 bg-slate-950/80 py-3 pl-4 pr-4 shadow-2xl shadow-lime-300/20 backdrop-blur transition hover:-translate-y-1"
>
  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-lime-300 text-slate-950">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5-.3.6-.6.8-.4 1.1.7 1.2 1.6 2 2.8 2.6.3.2.5.1.7-.1l.8-.9c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.6.4 0 .1 0 .7-.3 1.4z"/></svg>
  </span>
  <span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-bold text-white transition-all duration-300 group-hover:max-w-[140px] hidden sm:inline">Hablemos</span>
</a>
