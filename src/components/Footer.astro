---
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';

const directas = [
  {
    etiqueta: 'WhatsApp',
    valor: '+54 9 3364 00-6452',
    href: site.whatsappLink,
  },
  {
    etiqueta: 'Gmail',
    valor: site.email,
    href: `mailto:${site.email}`,
  },
];
---

<footer id="contacto" class="relative overflow-hidden bg-[#f8f9fa]">
  <div aria-hidden="true" class="veil"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="reveal-card" style="transition-delay: 0ms;">
        <p
          class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]"
        >
          Contacto
        </p>
        <h2
          class="mt-3 text-[32px] font-semibold leading-[1.25] text-[#0f172a]"
        >
          Contacto directo
        </h2>
        <p class="mt-3 max-w-md text-[18px] leading-[1.6] text-[#334155]">
          Escribime por el canal que prefieras y contame qué proceso
          querés ordenar. Respondo en 24 hs.
        </p>
        <ul class="mt-6 space-y-2">
          {
            directas.map((d) => (
              <li>
                <a
                  href={d.href}
                  target={d.etiqueta === 'WhatsApp' ? '_blank' : undefined}
                  rel={d.etiqueta === 'WhatsApp' ? 'noopener' : undefined}
                  class="flex flex-col items-start gap-1 rounded-[16px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5] sm:flex-row sm:items-center sm:gap-3"
                >
                  <span class="w-24 shrink-0 text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]">
                    {d.etiqueta}
                  </span>
                  <span class="text-[16px] font-medium text-[#005bb5]">
                    {d.valor}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="glass-panel reveal-card p-6 sm:p-8"
        style="transition-delay: 120ms;"
      >
        <ContactForm />
      </div>
    </div>

    <div class="mt-12 border-t border-[#e2e8f0] pt-8">
      <div
        class="flex flex-col gap-3 text-center text-[14px] text-[#334155] sm:flex-row sm:items-center sm:justify-between sm:text-left"
      >
        <p>{site.nombre} · {site.ubicacion}</p>
        <div class="flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-5">
          <a
            href={`mailto:${site.email}`}
            class="rounded-[4px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
          >
            {site.email}
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener"
            class="rounded-[4px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var cards = document.querySelectorAll('.reveal-card');
    if (!cards.length) return;
    // Sin animación si el usuario la desactiva o no hay IntersectionObserver:
    // todo queda visible directamente.
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      return;
    }
    cards.forEach(function (el) { el.classList.add('will-reveal'); });
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            en.target.classList.add('is-visible');
            io.unobserve(en.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    cards.forEach(function (el) { io.observe(el); });
  })();
</script>
