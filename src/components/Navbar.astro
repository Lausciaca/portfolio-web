---
import { site } from '../data/site';
---

<div class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-4">
  <header id="navbar" class="mx-auto max-w-6xl rounded-2xl border border-slate-200/80 bg-white/70 shadow-lg shadow-slate-900/5 backdrop-blur-md transition-all duration-300 dark:border-white/10 dark:bg-slate-950/40 dark:shadow-black/40">
    <nav class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5">
      <a href="#inicio" class="flex items-center gap-3">
        <span class="flex flex-col leading-tight">
          <span class="font-display text-[15px] font-bold tracking-tight text-slate-900 dark:text-white sm:text-base">{site.nombre}<span class="text-lime-500 dark:text-lime-300">.</span></span>
          <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">{site.rol}</span>
        </span>
      </a>

      <div class="hidden items-center gap-1 text-sm font-medium lg:flex">
        <a href="#trabajos" class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-900/5 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white">Trabajos</a>
        <a href="#servicios" class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-900/5 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white">Servicios</a>
        <a href="#proceso" class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-900/5 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white">Proceso</a>
        <a href="#sobre-mi" class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-900/5 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white">Sobre mí</a>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar modo claro / oscuro"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-600 transition hover:bg-slate-100 dark:border-white/10 dark:text-slate-300 dark:hover:bg-white/10"
        >
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a
          href="#contacto"
          class="group hidden items-center gap-2 rounded-xl bg-lime-300 px-4 py-2.5 text-sm font-bold text-slate-950 shadow-[0_0_24px_-6px_rgba(190,242,100,0.6)] transition hover:bg-lime-200 sm:inline-flex"
        >
          Pedir presupuesto
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#contacto" class="inline-flex rounded-xl bg-lime-300 px-3 py-2.5 text-sm font-bold text-slate-950 sm:hidden">Cotizar</a>
      </div>
    </nav>
  </header>
</div>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
  });
  const nav = document.getElementById('navbar');
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.classList.add('glass', 'shadow-xl');
    } else {
      nav.classList.remove('glass', 'shadow-xl');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
