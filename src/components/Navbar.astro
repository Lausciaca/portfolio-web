---
import { site } from '../data/site';
---

<a href="#contenido" class="skip-link">Saltar al contenido</a>

<!--
  EXCEPCIÓN A DESIGN.MD: el spec pide nav full-width pegado con border-bottom.
  Acá se usa barra flotante glass (radius 12px, blur, sombra sobria) por
  decisión explícita del usuario. El resto del sistema sigue tokens strict.
-->
<div class="fixed inset-x-0 top-3 z-50 px-3 sm:px-6">
  <header
    id="site-header"
    class="nav-float mx-auto max-w-6xl rounded-[24px]"
  >
    <div class="flex h-16 items-center justify-between px-4 sm:px-6">
      <a
        href="/"
        class="flex min-w-0 items-center gap-2.5 rounded-[8px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
        aria-label={`${site.nombre} — inicio`}
      >
        <span class="truncate text-[15px] font-semibold text-[#0f172a]">
          {site.nombre}
        </span>
        <span aria-hidden="true" class="wordmark-divider"></span>
        <span class="hidden text-[14px] font-medium text-[#64748b] min-[420px]:inline">
          Sistemas a medida
        </span>
      </a>

      <nav aria-label="Navegación principal" class="hidden items-center gap-6 md:flex">
        <a href="/#proyectos" class="nav-link">Proyectos</a>
        <a href="/#servicios" class="nav-link">Servicios</a>
        <a href="/#contacto" class="nav-link">Contacto</a>
        <a href="/#contacto" class="btn-primary btn-nav">Contactar</a>
      </nav>

      <div class="flex items-center gap-2 md:hidden">
        <a href="/#contacto" class="btn-primary btn-nav">Contactar</a>
        <button
          type="button"
          id="nav-toggle"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-[#e2e8f0] bg-white/80 text-[#0f172a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
        >
          <svg
            id="icon-open"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            id="icon-close"
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="hidden rounded-b-[24px] border-t border-[#e2e8f0] md:hidden"
    >
      <nav aria-label="Navegación móvil" class="flex flex-col gap-1 px-4 py-4 sm:px-6">
        <a href="/#proyectos" class="mobile-link">Proyectos</a>
        <a href="/#servicios" class="mobile-link">Servicios</a>
        <a href="/#contacto" class="mobile-link">Contacto</a>
        <a href="/#contacto" class="btn-primary mt-2 w-full">Contactar</a>
      </nav>
    </div>
  </header>
</div>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    var toggle = document.getElementById('nav-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('icon-open');
    var iconClose = document.getElementById('icon-close');

    // Sombra reforzada al hacer scroll
    var onScroll = function () {
      if (!header) return;
      if (window.scrollY > 8) header.classList.add('is-scrolled');
      else header.classList.remove('is-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Menú móvil
    if (!toggle || !menu) return;
    var setOpen = function (open) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.classList.toggle('hidden', !open);
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', function () {
      var open = menu.classList.contains('hidden');
      setOpen(open);
    });
    menu.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
