---
import { proyectos } from '../data/projects';

const [destacado, ...resto] = proyectos;
---

<section id="proyectos" class="relative overflow-hidden bg-white">
  <div aria-hidden="true" class="veil"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p
        class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]"
      >
        Portafolio
      </p>
      <h2
        class="mt-3 text-[32px] font-semibold leading-[1.25] text-[#0f172a]"
      >
        Proyectos en producción
      </h2>
      <p class="mt-3 text-[16px] leading-[1.55] text-[#334155]">
        Sistemas en producción para municipios, clubes, instituciones
        educativas y organizaciones profesionales.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <article
        class="card-project reveal-card flex flex-col md:col-span-2 lg:col-span-2"
        style="transition-delay: 0ms;"
      >
        <p
          class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]"
        >
          {destacado.cliente} · Caso destacado
        </p>
        <h3
          class="mt-2 max-w-xl text-[24px] font-semibold leading-[1.3] text-[#0f172a] sm:text-[28px]"
        >
          {destacado.titulo}
        </h3>
        <p
          class="mt-3 max-w-2xl flex-1 text-[16px] font-normal leading-[1.55] text-[#334155]"
        >
          {destacado.resumen}
        </p>
        <a
          href={`/proyectos/${destacado.slug}`}
          class="mt-6 inline-flex items-center gap-1 self-start rounded-[4px] text-[15px] font-medium text-[#2563eb] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
        >
          Ver caso de estudio
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </article>

      {
        resto.map((p, i) => (
          <article
            class="card-project reveal-card flex flex-col"
            style={`transition-delay: ${(i + 1) * 80}ms;`}
          >
            <p class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]">
              {p.cliente}
            </p>
            <h3 class="mt-2 text-[24px] font-semibold leading-[1.3] text-[#0f172a]">
              {p.titulo}
            </h3>
            <p class="mt-3 flex-1 text-[16px] font-normal leading-[1.55] text-[#334155]">
              {p.resumen}
            </p>
            <a
              href={`/proyectos/${p.slug}`}
              class="mt-6 inline-flex items-center gap-1 self-start rounded-[4px] text-[15px] font-medium text-[#2563eb] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
            >
              Ver caso de estudio
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </article>
        ))
      }

      <article
        class="reveal-card relative flex flex-col justify-center overflow-hidden rounded-[24px] border border-white/20 bg-[rgba(0,91,181,0.82)] p-6 text-white shadow-[0_12px_32px_-16px_rgba(0,91,181,0.5)] backdrop-blur-xl md:col-span-1 sm:p-8 lg:col-span-2"
        style="transition-delay: 480ms;"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0"
          style="background: radial-gradient(420px 220px at 85% 0%, rgba(255, 255, 255, 0.12), transparent 70%);"
        ></div>
        <div class="relative">
          <h3 class="text-[24px] font-semibold leading-[1.3]">
            ¿Tenés un proyecto en mente?
          </h3>
          <p class="mt-3 max-w-xl text-[16px] leading-[1.55] text-white/90">
            Contame qué necesitás y te propongo una solución a medida para tu
            organización.
          </p>
          <div class="mt-6">
            <a
              href="/#contacto"
              class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-[15px] font-medium text-[#005bb5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            >
              Hablar de mi proyecto
              <svg
                class="ml-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
