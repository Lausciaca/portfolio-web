---
import { site } from '../data/site';

const ventajas = [
  'Menos papeles y planillas',
  'Procesos administrativos más ágiles',
  'Socios y clientes ordenados',
  'Carnets digitales',
  'Cobros y reportes claros',
  'Atención online 24/7',
  'Menos errores manuales',
  'Más inscriptos y ventas',
];
---

<section id="inicio" class="mesh-bg relative overflow-hidden">
  <div class="grid-bg absolute inset-0"></div>
  <div class="relative mx-auto max-w-6xl px-4 pt-28 pb-10 sm:px-6 sm:pt-36">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="reveal">
        <p class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-slate-100 px-3.5 py-1.5 text-xs font-semibold text-slate-700 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
          <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-lime-500 dark:bg-lime-300"></span>
          Disponible para nuevos proyectos · Respuesta en 24hs
        </p>
        <h1 class="font-display mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl lg:text-[4.2rem]">
          Sistemas a medida que <span class="text-gradient">ahorran tiempo</span> y traen clientes.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
          {site.subtagline}
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={site.whatsappLink}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center gap-2.5 rounded-2xl bg-lime-300 px-6 py-3.5 font-bold text-slate-950 shadow-[0_0_32px_-8px_rgba(190,242,100,0.7)] transition hover:-translate-y-0.5 hover:bg-lime-200"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5-.3.6-.6.8-.4 1.1.7 1.2 1.6 2 2.8 2.6.3.2.5.1.7-.1l.8-.9c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.6.4 0 .1 0 .7-.3 1.4z"/></svg>
            Hablar por WhatsApp
          </a>
          <a
            href="#trabajos"
            class="inline-flex items-center gap-2 rounded-2xl border border-slate-300 bg-white px-6 py-3.5 font-bold text-slate-900 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:bg-slate-100 dark:border-white/15 dark:bg-white/5 dark:text-white dark:shadow-none dark:hover:bg-white/10"
          >
            Ver trabajos reales
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
        </div>
        <p class="mt-5 flex items-center gap-2 text-sm text-slate-500">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {site.ubicacion} · Trabajo para todo el país
        </p>
      </div>

      <div class="reveal reveal-delay-1">
        <div class="animate-float rounded-3xl border border-slate-200 bg-white p-5 shadow-2xl shadow-indigo-500/10 backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/70 dark:shadow-indigo-500/20">
          <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Respaldo comprobado</p>
            <span class="rounded-full bg-lime-500/15 px-2.5 py-1 text-[11px] font-bold text-lime-700 dark:bg-lime-300/15 dark:text-lime-300">En producción</span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-white/10 dark:bg-white/5">
              <p class="font-display min-h-[2.5rem] text-3xl font-extrabold text-slate-900 dark:text-white"><span data-count="1800" data-suffix="+">1800+</span></p>
              <p class="mt-1 text-xs leading-snug text-slate-600 dark:text-slate-400">usuarios se postularon en Bolsa de Empleo</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-white/10 dark:bg-white/5">
              <p class="font-display min-h-[2.5rem] text-3xl font-extrabold text-slate-900 dark:text-white"><span data-count="5" data-suffix="">5</span></p>
              <p class="mt-1 text-xs leading-snug text-slate-600 dark:text-slate-400">sistemas funcionando hoy mismo</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-white/10 dark:bg-white/5">
              <p class="font-display min-h-[2.5rem] text-3xl font-extrabold text-slate-900 dark:text-white"><span data-count="24" data-suffix="hs">24hs</span></p>
              <p class="mt-1 text-xs leading-snug text-slate-600 dark:text-slate-400">tiempo de respuesta a tu consulta</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-lime-300 p-4 text-slate-950">
              <p class="font-display text-lg font-extrabold leading-tight">¿Necesitás algo así?</p>
              <a href="#contacto" class="mt-2 inline-flex items-center gap-1 text-sm font-bold underline underline-offset-4">
                Pedir presupuesto gratis
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="relative border-y border-slate-200 bg-slate-100/80 py-4 backdrop-blur dark:border-white/10 dark:bg-black/20">
    <div class="flex overflow-hidden">
      <div class="animate-marquee flex shrink-0 items-center gap-10 pr-10">
        {[...ventajas, ...ventajas].map((v) => (
          <span class="flex items-center gap-10 whitespace-nowrap text-sm font-semibold uppercase tracking-[0.2em] text-slate-600 dark:text-slate-300">
            <svg class="h-4 w-4 shrink-0 text-lime-600 dark:text-lime-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            {v} <span class="text-lime-600/50 dark:text-lime-300/60">✦</span>
          </span>
        ))}
      </div>
      <div class="animate-marquee flex shrink-0 items-center gap-10 pr-10" aria-hidden="true">
        {[...ventajas, ...ventajas].map((v) => (
          <span class="flex items-center gap-10 whitespace-nowrap text-sm font-semibold uppercase tracking-[0.2em] text-slate-600 dark:text-slate-300">
            <svg class="h-4 w-4 shrink-0 text-lime-600 dark:text-lime-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            {v} <span class="text-lime-600/50 dark:text-lime-300/60">✦</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
