---
import { site } from '../data/site';
import ClientMarquee from './ClientMarquee.astro';

const [headlineBefore, headlineAfter] = site.heroHeadline.split(
  site.heroHeadlineAccent
);
---

<section class="relative overflow-hidden bg-[#f8f9fa]">
  <div aria-hidden="true" class="hero-glow"></div>
  <div class="relative mx-auto max-w-6xl px-6 pb-12 pt-24 sm:pt-36">
    <div class="mx-auto max-w-4xl text-center">
      <h1
        class="text-[40px] font-bold leading-[1.15] tracking-[-1px] text-[#0f172a] sm:text-[56px]"
      >
        {headlineBefore}<span class="text-[#005bb5]"
          >{site.heroHeadlineAccent}</span
        >{headlineAfter}
      </h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-[18px] font-normal leading-[1.6] text-[#334155]"
      >
        {site.heroSubtitle}
      </p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/#proyectos" class="btn-primary">Ver proyectos</a>
        <a
          href={site.whatsappLink}
          target="_blank"
          rel="noopener"
          class="btn-secondary">Hablar por WhatsApp</a
        >
      </div>
      <p class="mt-5 text-[14px] font-normal leading-[1.5] text-[#64748b]">
        {site.heroMicrocopy}
      </p>
    </div>

    <ClientMarquee />

    <div id="scroll-hint-wrap" class="mt-8 flex justify-center">
      <a
        href="/#proyectos"
        class="scroll-hint"
        aria-label="Bajar a ver los proyectos"
      >
        <svg
          class="block h-5 w-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var wrap = document.getElementById('scroll-hint-wrap');
    if (!wrap) return;
    var ticking = false;
    var onScroll = function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        if (window.scrollY > 100) wrap.classList.add('is-hidden');
        else wrap.classList.remove('is-hidden');
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
