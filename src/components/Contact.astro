---
import { site } from '../data/site';
---

<section id="contacto" class="mesh-bg relative overflow-hidden py-16 sm:py-24">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="reveal">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-700 dark:text-cyan-300">Contacto</p>
        <h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
          Pedí tu presupuesto <span class="text-gradient">gratis</span>
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
          Contame en 2 líneas qué necesitás y en 24hs te digo si se puede hacer, cuánto sale y en cuánto tiempo.
        </p>
        <div class="mt-7 space-y-3">
          <a href={site.whatsappLink} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-2xl bg-lime-300 p-5 font-bold text-slate-950 shadow-[0_0_32px_-8px_rgba(190,242,100,0.7)] transition hover:-translate-y-0.5 hover:bg-lime-200">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950/10">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5-.3.6-.6.8-.4 1.1.7 1.2 1.6 2 2.8 2.6.3.2.5.1.7-.1l.8-.9c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.6.4 0 .1 0 .7-.3 1.4z"/></svg>
            </span>
            <span>WhatsApp directo
              <span class="block text-sm font-medium opacity-70">La forma más rápida — tocá y hablamos</span>
            </span>
            <svg class="ml-auto h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${site.email}`} class="rounded-2xl border border-slate-200 bg-white p-5 font-bold text-slate-900 shadow-sm dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:shadow-none backdrop-blur transition hover:bg-slate-50 dark:hover:bg-white/[0.08]">
              <span class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6L22 7"/></svg>Email</span>
              <span class="mt-1 block truncate text-[15px]">{site.email}</span>
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener" class="rounded-2xl border border-slate-200 bg-white p-5 font-bold text-slate-900 shadow-sm dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:shadow-none backdrop-blur transition hover:bg-slate-50 dark:hover:bg-white/[0.08]">
              <span class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>LinkedIn</span>
              <span class="mt-1 block text-[15px]">Ver perfil profesional</span>
            </a>
          </div>
        </div>
      </div>

      <form id="contact-form" class="reveal reveal-delay-1 rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl shadow-slate-900/5 backdrop-blur-xl sm:p-8 dark:border-white/10 dark:bg-slate-900/70 dark:shadow-black/40">
        <label class="block text-sm font-bold text-slate-800 dark:text-slate-200" for="nombre">Tu nombre *</label>
        <input id="nombre" name="nombre" required placeholder="Ej: María del Club Náutico..." class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-lime-600/60 focus:ring-2 focus:ring-lime-500/20 dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-lime-300/60 dark:focus:ring-lime-300/20" />

        <label class="mt-4 block text-sm font-bold text-slate-800 dark:text-slate-200" for="contacto-medio">Tu WhatsApp o email *</label>
        <input id="contacto-medio" name="contacto" required placeholder="Ej: 3364 00-0000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-lime-600/60 focus:ring-2 focus:ring-lime-500/20 dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-lime-300/60 dark:focus:ring-lime-300/20" />

        <label class="mt-4 block text-sm font-bold text-slate-800 dark:text-slate-200" for="mensaje">¿Qué sistema necesitás? *</label>
        <textarea id="mensaje" name="mensaje" required rows={5} placeholder="Ej: llevamos los socios en Excel y queremos carnets digitales..." class="mt-1.5 w-full resize-none rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-lime-600/60 focus:ring-2 focus:ring-lime-500/20 dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-lime-300/60 dark:focus:ring-lime-300/20"></textarea>

        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <button type="submit" id="contact-btn" class="mt-5 w-full rounded-xl bg-lime-300 px-6 py-3.5 font-bold text-slate-950 transition hover:-translate-y-0.5 hover:bg-lime-200 disabled:opacity-60">
          Enviar consulta
        </button>
        <p id="contact-status" class="mt-3 text-center text-sm font-semibold"></p>
        <p class="mt-2 text-center text-xs leading-relaxed text-slate-500">
          Te respondo en menos de 24hs. Si prefieres, escribime directo por WhatsApp.
        </p>
      </form>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const btn = document.getElementById('contact-btn');
    const status = document.getElementById('contact-status');
    const WEB3FORMS_KEY = 'b93c5c63-0d60-41b7-9430-c45c9e8a5b74';
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !(form instanceof HTMLFormElement)) return;
      if (WEB3FORMS_KEY.startsWith('TU-ACCESS')) {
        status.textContent = 'Configura tu key de Web3Forms o escribime por WhatsApp directo.';
        status.className = 'mt-3 text-center text-sm font-semibold text-amber-600 dark:text-amber-300';
        return;
      }
      btn.disabled = true;
      status.textContent = 'Enviando...';
      status.className = 'mt-3 text-center text-sm font-semibold text-slate-500 dark:text-slate-300';
      const data = new FormData(form);
      data.append('access_key', WEB3FORMS_KEY);
      data.append('subject', 'Nueva consulta desde portfolio web');
      data.append('from_name', 'Portfolio Web');
      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
        const json = await res.json();
        if (json.success) {
          status.textContent = 'Listo, mensaje enviado. Te respondo en menos de 24hs.';
          status.className = 'mt-3 text-center text-sm font-semibold text-lime-700 dark:text-lime-300';
          form.reset();
        } else { throw new Error('error'); }
      } catch {
        status.textContent = 'Hubo un error. Probá por WhatsApp directo.';
        status.className = 'mt-3 text-center text-sm font-semibold text-rose-600 dark:text-rose-300';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</section>
