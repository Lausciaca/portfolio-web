---
import { site } from '../data/site';

const pasos = [
  {
    n: '01',
    paso: 'Paso 1',
    t: 'Charla de 15 min',
    d: 'Me contás qué necesitás por WhatsApp o videollamada. Sin tecnicismos, hablamos de tu negocio.',
    meta: 'Sin costo',
    icon: '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/>',
  },
  {
    n: '02',
    paso: 'Paso 2',
    t: 'Propuesta clara',
    d: 'Te paso precio, tiempos y qué incluye, por escrito. Sin letra chica ni sorpresas.',
    meta: 'En 24–48hs',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/>',
  },
  {
    n: '03',
    paso: 'Paso 3',
    t: 'Avances por etapas',
    d: 'Vas viendo el sistema funcionando y me das tu opinión antes de seguir. Vos aprobás cada parte.',
    meta: 'Vos aprobás',
    icon: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
  },
  {
    n: '04',
    paso: 'Paso 4',
    t: 'Entrega + soporte',
    d: 'Lo dejamos online funcionando, capacito a tu equipo y te acompaño después de la entrega.',
    meta: 'Online + ayuda',
    icon: '<path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2 0-2.8-.8-.7-2.2-.7-3 .8z"/><path d="M12 15l-3-3a22 22 0 0 1 2-4A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.5-3.8 2-6c1.6-2.3 5-3 5-3M12 15v5s3.8-.5 6-2c2.3-1.6 3-5 3-5"/>',
  },
];
---

<section id="proceso" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="reveal max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-600 dark:text-cyan-300">Simple y sin vueltas</p>
    <h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">Cómo trabajo</h2>
    <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      Un proceso corto pensado para que no tengas que saber nada técnico. Siempre sabés en qué punto estamos y qué sigue.
    </p>
  </div>

  <div class="relative mt-12">
    <!-- línea conectora desktop -->
    <div class="absolute left-[12%] right-[12%] top-7 hidden h-px bg-slate-300 md:block dark:bg-white/15" aria-hidden="true"></div>
    <div class="absolute left-[12%] right-[12%] top-7 hidden h-px bg-gradient-to-r from-lime-300/0 via-lime-300/70 to-lime-300/0 md:block" aria-hidden="true"></div>
    <!-- línea vertical mobile -->
    <div class="absolute bottom-6 left-7 top-4 w-px bg-slate-200 md:hidden dark:bg-white/10" aria-hidden="true"></div>

    <ol class="relative grid gap-5 md:grid-cols-4">
      {pasos.map((p, i) => (
        <li class={`reveal ${i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : i === 3 ? 'reveal-delay-3' : ''} card-hover relative rounded-3xl border border-slate-200 bg-white p-6 pl-20 shadow-sm md:pl-6 md:pt-16 dark:border-white/10 dark:bg-slate-900/60 dark:shadow-none`}>
          <!-- nodo icono -->
          <span class="absolute left-4 top-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-lime-300/40 bg-slate-950 text-lime-300 shadow-[0_0_24px_-8px_rgba(190,242,100,0.7)] md:left-1/2 md:top-0 md:-translate-x-1/2 md:-translate-y-0 dark:bg-slate-950" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
          </span>
          <span class="font-display pointer-events-none absolute right-5 top-4 text-4xl font-extrabold text-slate-200/70 md:top-12 dark:text-white/[0.07]" aria-hidden="true">{p.n}</span>

          <p class="inline-flex items-center gap-1.5 rounded-full bg-lime-500/15 px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-lime-700 dark:bg-lime-300/15 dark:text-lime-300">
            {p.paso}
          </p>
          <h3 class="font-display mt-2.5 font-bold text-slate-900 dark:text-white">{p.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{p.d}</p>
          <p class="mt-4 flex items-center gap-1.5 border-t border-slate-100 pt-3 text-xs font-bold text-slate-500 dark:border-white/10 dark:text-slate-400">
            <svg class="h-3.5 w-3.5 text-lime-600 dark:text-lime-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            {p.meta}
          </p>
        </li>
      ))}
    </ol>
  </div>

  <div class="reveal mt-8 flex flex-col items-center justify-between gap-4 rounded-3xl border border-lime-300/25 bg-gradient-to-r from-lime-300/10 via-transparent to-cyan-400/10 p-6 text-center sm:flex-row sm:text-left dark:border-lime-300/20">
    <div>
      <p class="font-display font-bold text-slate-900 dark:text-white">Empezamos por la charla, sin compromiso</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Contame tu idea y en 24hs te digo si se puede hacer y cuánto sale.</p>
    </div>
    <a
      href={site.whatsappLink}
      target="_blank"
      rel="noopener"
      class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-lime-300 px-6 py-3 text-sm font-bold text-slate-950 shadow-[0_0_28px_-8px_rgba(190,242,100,0.8)] transition hover:-translate-y-0.5 hover:bg-lime-200"
    >
      Agendar charla gratis
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>
