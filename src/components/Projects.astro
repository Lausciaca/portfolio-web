---
import { proyectos } from '../data/projects';
import { site } from '../data/site';

// Acento fijo por proyecto (no cambia si se reordena el array)
const acentos: Record<string, string> = {
  'saas-agrimensores': 'from-amber-400/25 via-amber-400/5',
  'gestion-clubes': 'from-sky-500/25 via-sky-500/5',
  'ifvc': 'from-violet-500/25 via-violet-500/5',
  'bolsa-empleo': 'from-emerald-400/25 via-emerald-400/5',
  'prode-copa': 'from-rose-500/25 via-rose-500/5',
};

const waText = (t: string) =>
  `${site.whatsappLink.split('?')[0]}?text=${encodeURIComponent(`Hola Laureano, vi tu trabajo "${t}" y quiero algo así para mi caso`)}`;
---

<section id="trabajos" class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="reveal max-w-3xl">
    <p class="inline-flex items-center gap-2 rounded-full border border-lime-600/25 bg-lime-500/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-lime-700 dark:border-lime-300/20 dark:bg-lime-300/10 dark:text-lime-300">
      Casos reales
    </p>
    <h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight sm:text-5xl">
      Sistemas que hoy <span class="text-gradient">ya están funcionando</span>
    </h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      No son maquetas: los usan municipios, institutos, clubes y profesionales todos los días.
      Si necesitás algo parecido, lo adapto a tu caso.
    </p>
  </div>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {proyectos.map((p, i) => (
      <article class={`reveal card-hover group relative flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white bg-gradient-to-b ${acentos[p.id] ?? 'from-indigo-500/20 via-indigo-500/5'} to-transparent shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-900/40 dark:shadow-none ${i === 0 ? 'md:col-span-2' : ''}`}>
        {p.imagen ? (
          <div class="relative overflow-hidden border-b border-slate-200 dark:border-white/10">
            <div class="flex items-center gap-1.5 bg-slate-100 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
              <span class="ml-3 truncate text-xs font-semibold text-slate-600">{p.titulo}</span>
            </div>
            <img
              src={p.imagen}
              alt={`Captura de ${p.titulo}`}
              loading="lazy"
              class={p.ajuste === 'cover'
                ? `${p.aspecto ?? 'aspect-video'} w-full bg-slate-950 object-cover object-top`
                : 'h-48 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]'}
            />
            <span class="absolute left-4 top-12 rounded-full bg-black/60 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-lime-300 backdrop-blur">
              {p.cliente}
            </span>
          </div>
        ) : (
          <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-6 pt-5 sm:px-7 dark:border-white/10">
            <span class="mb-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-900/[0.04] px-3 py-1.5 text-[11px] font-bold uppercase tracking-widest text-slate-600 dark:bg-white/10 dark:text-slate-300">
              <svg class="h-3.5 w-3.5 text-lime-600 dark:text-lime-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {p.cliente}
            </span>
            <span class="font-display pointer-events-none select-none text-4xl font-extrabold text-slate-200/80 dark:text-white/[0.08]" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
        )}
        <div class="flex flex-1 flex-col p-6 sm:p-7">
          <h3 class="font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-2xl">{p.titulo}</h3>
          <div class="mt-4 space-y-2.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">
            <p><strong class="font-semibold text-slate-900 dark:text-slate-200">Antes:</strong> {p.problema}</p>
            <p><strong class="font-semibold text-slate-900 dark:text-slate-200">Solución:</strong> {p.solucion}</p>
            <p><strong class="font-semibold text-slate-900 dark:text-slate-200">Resultado:</strong> {p.resultado}</p>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.stack.map((t) => (
              <span class="rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
                {t}
              </span>
            ))}
          </div>
          <div class="mt-6 flex flex-col gap-2.5 pt-1">
            <a href={waText(p.titulo)} target="_blank" rel="noopener" class="rounded-xl bg-slate-900 px-4 py-3 text-center text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-slate-700 dark:bg-white dark:text-slate-950 dark:hover:bg-lime-300">
              Quiero un sistema así
            </a>
            <a href="#contacto" class="text-center text-sm font-bold text-slate-500 underline-offset-4 transition hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-white">
              o pedir presupuesto por el formulario →
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
