---
import { servicios } from '../data/site';
---

<section id="servicios" class="bg-white">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <div class="max-w-2xl">
      <p
        class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]"
      >
        Servicios
      </p>
      <h2
        class="mt-3 text-[32px] font-semibold leading-[1.25] text-[#0f172a]"
      >
        Qué hago
      </h2>
    </div>

    <div class="mt-10 divide-y divide-[#e2e8f0] border-y border-[#e2e8f0]">
      {
        servicios.map((s, i) => (
          <div
            class="reveal-card grid gap-2 py-8 sm:py-10 md:grid-cols-[64px_1fr] md:gap-6"
            style={`transition-delay: ${i * 100}ms;`}
          >
            <p class="text-[15px] font-semibold text-[#005bb5]">{s.numero}</p>
            <div>
              <h3 class="text-[24px] font-semibold leading-[1.3] text-[#0f172a]">
                {s.titulo}
              </h3>
              <p class="mt-3 max-w-2xl text-[16px] font-normal leading-[1.55] text-[#334155]">
                {s.descripcion}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
