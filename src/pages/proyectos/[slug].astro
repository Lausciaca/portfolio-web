---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { proyectos } from '../../data/projects';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      proyecto: p,
      anterior: proyectos[(i - 1 + proyectos.length) % proyectos.length],
      siguiente: proyectos[(i + 1) % proyectos.length],
    },
  }));
}

const { proyecto, anterior, siguiente } = Astro.props;

const secciones = [
  { numero: '01', titulo: 'El problema', texto: proyecto.problema },
  { numero: '02', titulo: 'La solución', texto: proyecto.solucion },
  { numero: '03', titulo: 'El impacto', texto: proyecto.impacto },
];
---

<BaseLayout
  title={`${proyecto.titulo} — ${proyecto.cliente}`}
  description={proyecto.resumen}
>
  <Navbar />
  <main id="contenido" class="relative overflow-hidden bg-white">
    <div aria-hidden="true" class="veil"></div>
    <div class="relative mx-auto max-w-3xl px-6 pb-16 pt-28 sm:pt-32">
      <a
        href="/#proyectos"
        class="inline-flex items-center gap-1 rounded-[4px] text-[15px] font-medium text-[#2563eb] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M11 18l-6-6 6-6"></path>
        </svg>
        Volver a proyectos
      </a>

      <p
        class="mt-8 text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]"
      >
        {proyecto.cliente} · {proyecto.metrica}
      </p>
      <h1
        class="mt-2 text-[40px] font-bold leading-[1.2] text-[#0f172a]"
      >
        {proyecto.titulo}
      </h1>
      <div class="mt-4 flex flex-wrap gap-2">
        {proyecto.stack.map((t) => <span class="badge-tech">{t}</span>)}
      </div>

      <div class="mt-10 divide-y divide-[#e2e8f0] border-y border-[#e2e8f0]">
        {
          secciones.map((s, i) => (
            <section
              class="reveal-card grid gap-2 py-8 sm:py-10 md:grid-cols-[64px_1fr] md:gap-6"
              style={`transition-delay: ${i * 100}ms;`}
            >
              <p class="text-[15px] font-semibold text-[#005bb5]">
                {s.numero}
              </p>
              <div>
                <h2 class="text-[24px] font-semibold leading-[1.3] text-[#0f172a]">
                  {s.titulo}
                </h2>
                <p class="mt-3 text-[18px] font-normal leading-[1.6] text-[#334155]">
                  {s.texto}
                </p>
              </div>
            </section>
          ))
        }
      </div>

      <nav
        aria-label="Navegación entre proyectos"
        class="mt-12 grid gap-6 border-t border-[#e2e8f0] pt-8 sm:grid-cols-2"
      >
        <a
          href={`/proyectos/${anterior.slug}`}
          class="rounded-[4px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5]"
        >
          <span class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]">
            ← Anterior
          </span>
          <span class="mt-1 block text-[18px] font-semibold text-[#0f172a]">
            {anterior.titulo}
          </span>
        </a>
        <a
          href={`/proyectos/${siguiente.slug}`}
          class="rounded-[4px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005bb5] sm:text-right"
        >
          <span class="text-[12px] font-medium uppercase tracking-[0.5px] text-[#64748b]">
            Siguiente →
          </span>
          <span class="mt-1 block text-[18px] font-semibold text-[#0f172a]">
            {siguiente.titulo}
          </span>
        </a>
      </nav>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/#proyectos" class="btn-secondary"> Ver otros proyectos </a>
        <a href="/#contacto" class="btn-primary"> Contactar </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
